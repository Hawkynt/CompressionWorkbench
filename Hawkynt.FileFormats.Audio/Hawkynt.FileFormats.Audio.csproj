  <!-- Bundles every member ProjectReference's resolved DLL into lib/, EXCEPT
       Hawkynt.Compression.Core (a published NuGet dep, declared above) and
       Compression.Registry (already bundled inside Core's package). -->
  <Target Name="_AddBundledAssembliesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_BundledRefs Include="@(ReferencePath)"
                    Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'
                               and '%(ReferencePath.Extension)' == '.dll'
                               and !$([System.String]::Copy('%(ReferencePath.MSBuildSourceProjectFile)').EndsWith('Hawkynt.Compression.Core.csproj'))
                               and !$([System.String]::Copy('%(ReferencePath.MSBuildSourceProjectFile)').EndsWith('Compression.Registry.csproj'))" />
      <TfmSpecificPackageFile Include="@(_BundledRefs)" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

