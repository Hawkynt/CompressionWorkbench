<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The audio package. Every codec and container that belongs to this
         package alone compiles straight into Hawkynt.FileFormats.Audio.dll
         from the per-format folders under Codecs/ and FileFormats/, so
         consumers get one assembly instead of a hundred and sixty satellites.
         Formats shared with Hawkynt.FileFormats.Archives stay separate
         projects — compiling them here as well would give their types two
         identities, one per package — and are referenced below.

         No RootNamespace: every file states its namespace explicitly
         (Codec.Wma, FileFormat.Ogg, …), which is what makes the merge safe.

         The folder + .csproj filename equal the desired PackageId so the
         .NET 10 SDK can default $(PackageId) from $(MSBuildProjectName)
         without the fragile -p:PackageId override path documented in
         Compression.Core/Hawkynt.Compression.Core.csproj. -->

    <IsPackable>true</IsPackable>
    <Title>Hawkynt FileFormats Audio</Title>
    <Description>Pure-managed audio codecs and container readers/writers — PCM (raw, A-law, mu-law, IMA / MS-ADPCM, GSM 6.10), MP3 / AAC / Vorbis / Opus / FLAC / ALAC / APE / WavPack lossy + lossless, MIDI / OGG containers, Wav / Aiff / Au headers, and tracker formats (MOD / S3M / XM / IT) plus PSF chiptune + game audio bundles (Awb / Akb / Wwise / FMOD). Self-contained bundle on top of Hawkynt.Compression.Core.</Description>
    <PackageTags>$(PackageTags);audio;pcm;flac;mp3;aac;vorbis;opus;wav;aiff;midi;tracker;adpcm;managed</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Bundle every member project's DLL into lib/ so the package is one-stop.
         Compression.Core is intentionally NOT bundled here — it ships as its own
         NuGet package and is declared as a regular `<dependency>` in our nuspec
         (see the non-private ProjectReference further down). The bundle target
         filters Core / Registry out by MSBuildSourceProjectFile so we don't
         double-bundle assemblies that consumers already get via the Core dep. -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddBundledAssembliesToPackage</TargetsForTfmSpecificContentInPackage>

  </PropertyGroup>

  <!-- The audio tests reach into per-format internals (depayloaders, coefficient
       tables, bit readers). One entry now covers every format that used to carry
       its own. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Compression.Tests" />
  </ItemGroup>

  <!-- Note on the shared members below:
       They ship as bundled DLLs in lib/ and are referenced with PrivateAssets="all"
       so the auto-generated nuspec stays clean (one Hawkynt.Compression.Core
       dep + bundled member DLLs, nothing else).

       Consequence: PrivateAssets="all" blocks transitive type visibility, so
       in-tree projects (Compression.Lib / Compression.Tests / Compression.UI /
       etc.) keep their own explicit references to these shared projects. What
       they no longer need is a reference per audio-only format — one reference
       to this package supplies all of those types.

       Attempted-and-rejected workarounds:
         * Drop PrivateAssets="all": pack emits one nuspec <dependency> per
           member, all pointing at non-existent NuGet packages — install fails.
         * SuppressDependenciesWhenPacking=true + PackageReference to Core:
           the SDK's framework-suppression also strips PackageRefs for that
           tfm, producing NU5128 (no deps for the framework that has lib/).
         * Custom MSBuild filter target on _ProjectReferencesWithVersions:
           the items are evaluated in a child build that doesn't see the
           filter; nuspec dep list comes out unfiltered. -->

  <!-- README.md now sits alongside compiled source, so it arrives as a default
       None item and is updated rather than included a second time. -->
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Compression.Core: declared as a regular ProjectReference (no
       PrivateAssets) so `dotnet pack` emits it as a single NuGet `<dependency>`
       in our nuspec rather than bundling its DLL. The bundle target's filter
       further down skips it on the lib/ side.

       Compression.Registry is deliberately NOT listed: the absorbed formats
       compile against it, but it reaches this project transitively through the
       shared members below, exactly as it reached it through the per-format
       projects before. Naming it here would make it a declared package member
       and pull its 171 types into this package's generated API reference,
       where they do not belong — Core's package documents and ships them. -->
  <ItemGroup>
    <ProjectReference Include="..\Compression.Core\Hawkynt.Compression.Core.csproj" />
  </ItemGroup>

  <!-- Codecs shared with Hawkynt.FileFormats.Archives: the Wma / RealMedia / Bink /
       Smacker families its ASF, RealMedia, Bink and Smacker containers decode through,
       plus the companding and ADPCM cores both packages use. They stay separate
       assemblies so their types keep one identity across packages; their DLLs are
       bundled into lib/ by the target below. -->
  <ItemGroup>
    <ProjectReference Include="..\Codecs\Codec.ALaw\Codec.ALaw.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Aac\Codec.Aac.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Ac3\Codec.Ac3.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.AdpcmX\Codec.AdpcmX.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.AicaAdpcm\Codec.AicaAdpcm.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Alac\Codec.Alac.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Atrac3\Codec.Atrac3.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.BinkAudio\Codec.BinkAudio.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Cook\Codec.Cook.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Dfpwm\Codec.Dfpwm.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Flac\Codec.Flac.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.G722\Codec.G722.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.G72x\Codec.G72x.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Gsm610\Codec.Gsm610.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.ImaAdpcm\Codec.ImaAdpcm.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Mp3\Codec.Mp3.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.MsAdpcm\Codec.MsAdpcm.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.MuLaw\Codec.MuLaw.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.OkiAdpcm\Codec.OkiAdpcm.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Opus\Codec.Opus.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Pcm\Codec.Pcm.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Ra144\Codec.Ra144.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Ra288\Codec.Ra288.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Ralf\Codec.Ralf.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Sipr\Codec.Sipr.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.SmackerAudio\Codec.SmackerAudio.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.TrueSpeech\Codec.TrueSpeech.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Vorbis\Codec.Vorbis.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.Wma\Codec.Wma.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.WmaLossless\Codec.WmaLossless.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Codecs\Codec.WmaPro\Codec.WmaPro.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Containers shared with Hawkynt.FileFormats.Archives, which surfaces them as
       pseudo-archives: the A/V envelopes (MP4 / MOV, Matroska, AVI, ASF, RealMedia,
       Bink, Smacker), the CRI and PSF bundles, and FileFormat.Wav, which the ASF
       reader depends on. -->
  <ItemGroup>
    <ProjectReference Include="..\FileFormats\FileFormat.Akb\FileFormat.Akb.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Asf\FileFormat.Asf.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Avi\FileFormat.Avi.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Awb\FileFormat.Awb.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Bik\FileFormat.Bik.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Matroska\FileFormat.Matroska.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Mp4\FileFormat.Mp4.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Psf\FileFormat.Psf.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.RealMedia\FileFormat.RealMedia.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Smk\FileFormat.Smk.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Wav\FileFormat.Wav.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Bundles every member ProjectReference's resolved DLL into lib/, EXCEPT
       Hawkynt.Compression.Core (a published NuGet dep, declared above) and
       Compression.Registry (already bundled inside Core's package). -->
  <Target Name="_AddBundledAssembliesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_BundledRefs Include="@(ReferencePath)"
                    Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'
                               and '%(ReferencePath.Extension)' == '.dll'
                               and !$([System.String]::Copy('%(ReferencePath.MSBuildSourceProjectFile)').EndsWith('Hawkynt.Compression.Core.csproj'))
                               and !$([System.String]::Copy('%(ReferencePath.MSBuildSourceProjectFile)').EndsWith('Compression.Registry.csproj'))" />
      <TfmSpecificPackageFile Include="@(_BundledRefs)" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

</Project>
