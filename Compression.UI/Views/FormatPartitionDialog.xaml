<Window x:Class="Compression.UI.Views.FormatPartitionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Format Partition" Width="460" Height="240"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="HeadingLbl"
               Text="Format partition." FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Filesystem:" VerticalAlignment="Center" Margin="0,4" />
    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="FsCombo" Margin="0,4" IsEditable="False" />

    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
               Text="Only filesystems whose descriptors implement IArchiveCreatable are listed."
               Foreground="DimGray" TextWrapping="Wrap" Margin="0,8,0,0" />

    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="OkBtn" Content="OK" Width="80" Padding="4" Margin="0,0,8,0"
              IsDefault="True" Click="OnOk" />
      <Button Content="Cancel" Width="80" Padding="4" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
