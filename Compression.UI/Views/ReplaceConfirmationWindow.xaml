<Window x:Class="Compression.UI.Views.ReplaceConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replace existing entry?" Width="480" Height="220"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" FontWeight="Bold" FontSize="14"
               Text="An entry with this name already exists" Margin="0,0,0,8" />

    <TextBlock Grid.Row="1" x:Name="MessageText" TextWrapping="Wrap" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="_Yes"        Width="92" Padding="4" Margin="0,0,4,0" Click="OnYes" />
      <Button Content="Yes to _all" Width="92" Padding="4" Margin="0,0,4,0" Click="OnYesAll" />
      <Button Content="_Skip"       Width="92" Padding="4" Margin="0,0,4,0" Click="OnSkip" />
      <Button Content="S_kip all"   Width="92" Padding="4" Margin="0,0,4,0" Click="OnSkipAll" />
      <Button Content="_Cancel"     Width="92" Padding="4" Click="OnCancel" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
