<Window x:Class="Compression.UI.Views.TargetOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Target options" Width="520" MinWidth="420" Height="Auto" SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="HeadingLbl" FontWeight="SemiBold"
               Margin="0,0,0,4" TextWrapping="Wrap"
               Text="Configure target format." />

    <TextBlock Grid.Row="1" Foreground="DimGray" TextWrapping="Wrap"
               Margin="0,0,0,8"
               Text="Defaults are applied for any knob you don't change. Hover over a field for a description." />

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="OptionsHost">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
      </Grid>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkBtn" Content="OK" Width="80" Padding="4" Margin="0,0,8,0"
              IsDefault="True" Click="OnOk" />
      <Button Content="Cancel" Width="80" Padding="4" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </Grid>
</Window>
