<Window x:Class="Compression.UI.Views.LayoutProfileEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Layout profiles" Width="1000" Height="640" MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left rail: profile list -->
      <GroupBox Grid.Column="0" Header="Profiles">
        <DockPanel Margin="4">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="NewBtn" Content="New" Width="62" Padding="4" Margin="0,0,4,0" Click="OnNew" />
            <Button x:Name="SaveAsTopBtn" Content="Save As…" Width="80" Padding="4" Margin="0,0,4,0" Click="OnSaveAs" />
            <Button x:Name="DeleteBtn" Content="Delete" Width="62" Padding="4" Click="OnDelete" IsEnabled="False" />
          </StackPanel>
          <ListBox x:Name="ProfilesList" SelectionChanged="OnProfileSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" CornerRadius="3" Padding="4,1,4,1" Margin="6,0,0,0"
                          Background="{Binding BadgeBrush}">
                    <TextBlock Text="{Binding BadgeText}" FontSize="10" Foreground="White" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </GroupBox>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" ResizeBehavior="PreviousAndNext" />

      <!-- Right pane: editor -->
      <GroupBox Grid.Column="2" Header="Editor">
        <Grid Margin="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Header: name + metadata zone + leftover strategy -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,2,8,2" />
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="NameBox" VerticalContentAlignment="Center" Margin="0,2" TextChanged="OnNameChanged" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Metadata zone:" VerticalAlignment="Center" Margin="0,2,8,2" />
            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="MetadataZoneCombo" Margin="0,2"
                       SelectionChanged="OnHeaderChanged"
                       ToolTip="Where filesystem metadata (FAT, MFT, bitmaps, inode tables) and directory extents land during defragmentation.">
              <ComboBoxItem Content="Unchanged" Tag="Unchanged" />
              <ComboBoxItem Content="Front" Tag="Front" />
              <ComboBoxItem Content="Back" Tag="Back" />
              <ComboBoxItem Content="Middle" Tag="Middle" />
              <ComboBoxItem Content="BeforeContent" Tag="BeforeContent" />
            </ComboBox>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Leftover strategy:" VerticalAlignment="Center" Margin="0,2,8,2" />
            <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="LeftoverCombo" Margin="0,2"
                       SelectionChanged="OnHeaderChanged"
                       ToolTip="Where files matching no zone land. 'fill_gaps' = between zones, 'append_at_end' = after the last zone.">
              <ComboBoxItem Content="fill_gaps" Tag="fill_gaps" />
              <ComboBoxItem Content="append_at_end" Tag="append_at_end" />
            </ComboBox>
          </Grid>

          <!-- Zones list -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4">
            <TextBlock Text="Zones (placement order: first match wins)" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListView Grid.Column="0" x:Name="ZonesList" SelectionMode="Single" SelectionChanged="OnZoneSelectionChanged">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Name" Width="120" DisplayMemberBinding="{Binding Name}" />
                  <GridViewColumn Header="Range" Width="120" DisplayMemberBinding="{Binding Range}" />
                  <GridViewColumn Header="Filter" Width="220" DisplayMemberBinding="{Binding Filter}" />
                  <GridViewColumn Header="Sort" Width="180" DisplayMemberBinding="{Binding SortSummary}" />
                </GridView>
              </ListView.View>
            </ListView>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <Button x:Name="AddZoneBtn" Content="+ Add" Width="68" Padding="4" Margin="0,0,0,4" Click="OnAddZone" />
              <Button x:Name="RemoveZoneBtn" Content="– Remove" Width="68" Padding="4" Margin="0,0,0,4" Click="OnRemoveZone" IsEnabled="False" />
              <Button x:Name="MoveUpBtn" Content="↑ Up" Width="68" Padding="4" Margin="0,0,0,4" Click="OnMoveUp" IsEnabled="False" />
              <Button x:Name="MoveDownBtn" Content="↓ Down" Width="68" Padding="4" Click="OnMoveDown" IsEnabled="False" />
            </StackPanel>
          </Grid>

          <!-- Zone detail header -->
          <TextBlock Grid.Row="3" Text="Selected zone" FontWeight="SemiBold" Margin="0,10,0,4" />

          <!-- Zone-detail panel -->
          <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ZoneDetailGrid" IsEnabled="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Name -->
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,4,8,4" />
              <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ZoneNameBox" Margin="0,4" VerticalContentAlignment="Center"
                         TextChanged="OnZoneNameChanged" />

              <!-- Range -->
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Range:" VerticalAlignment="Center" Margin="0,4,8,4" />
              <Border    Grid.Row="1" Grid.Column="1" x:Name="ZoneRangeBorder" BorderBrush="Transparent" BorderThickness="1">
                <TextBox x:Name="ZoneRangeBox" Margin="0,4" VerticalContentAlignment="Center"
                         TextChanged="OnZoneRangeChanged"
                         ToolTip="Examples: 0%-5%, 10MB-50MB, [1024, 2048), 5%-, -50%" />
              </Border>
              <Button    Grid.Row="1" Grid.Column="2" Content="Validate" Width="80" Padding="4" Margin="6,4,0,4"
                         Click="OnValidateRange" />

              <!-- Range error -->
              <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ZoneRangeError"
                         Foreground="#C03030" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />

              <!-- Range preview bar (0-100% scale) -->
              <Canvas Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ZoneRangePreview"
                      Height="14" Background="#F4F4F4" Margin="0,0,0,4">
                <Rectangle x:Name="ZoneRangePreviewBar" Fill="#42A5F5" Height="14" Canvas.Top="0" />
              </Canvas>

              <!-- Filter -->
              <TextBlock Grid.Row="4" Grid.Column="0" Text="Filter:" VerticalAlignment="Top" Margin="0,6,8,4" />
              <Border    Grid.Row="4" Grid.Column="1" x:Name="ZoneFilterBorder" BorderBrush="Transparent" BorderThickness="1">
                <TextBox x:Name="ZoneFilterBox" Margin="0,4" MinHeight="48" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         TextChanged="OnZoneFilterChanged"
                         ToolTip="Predicate expression, e.g. lastModified &gt;= quartile(0.75)" />
              </Border>
              <Button    Grid.Row="4" Grid.Column="2" Content="Validate" Width="80" Padding="4" Margin="6,4,0,4"
                         VerticalAlignment="Top" Click="OnValidateFilter" />

              <!-- Filter error -->
              <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ZoneFilterError"
                         Foreground="#C03030" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />

              <!-- Field reference toggle -->
              <Expander Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Header="Show field reference"
                        Margin="0,0,0,6">
                <Border Background="#FAFAFA" Padding="6" BorderBrush="LightGray" BorderThickness="1">
                  <TextBlock TextWrapping="Wrap" FontSize="11">
                    <Run FontWeight="SemiBold">Fields:</Run><LineBreak />
                    name, path, extension, size, lastModified, lastAccessed, created, attributes<LineBreak />
                    <Run FontWeight="SemiBold">Operators:</Run> = != &lt; &lt;= &gt; &gt;= contains matches in<LineBreak />
                    <Run FontWeight="SemiBold">Logical:</Run> and, or, not (parentheses supported)<LineBreak />
                    <Run FontWeight="SemiBold">Functions:</Run><LineBreak />
                    quartile(0..1)  — p-th percentile across the file set (numeric/date fields)<LineBreak />
                    now()  / today()  — current UTC time / midnight<LineBreak />
                    days(n) / hours(n) / minutes(n)  — durations (subtract from now() / today())<LineBreak />
                    date("yyyy-MM-dd")  — explicit date literal<LineBreak />
                    <Run FontWeight="SemiBold">Examples:</Run><LineBreak />
                    lastModified &gt;= today() - days(30)<LineBreak />
                    size &gt; 1MB and name matches '.*\.log$'<LineBreak />
                    extension in ('.exe', '.dll', '.sys')
                  </TextBlock>
                </Border>
              </Expander>

              <!-- SortBy header -->
              <TextBlock Grid.Row="7" Grid.Column="0" Text="Sort by:" VerticalAlignment="Top" Margin="0,4,8,4" />
              <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4">
                <Button x:Name="AddSortBtn" Content="+ Add" Width="68" Padding="4" Margin="0,0,4,0" Click="OnAddSort" />
                <Button x:Name="RemoveSortBtn" Content="– Remove" Width="80" Padding="4" Click="OnRemoveSort" IsEnabled="False" />
              </StackPanel>

              <!-- SortBy list -->
              <ListView Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" x:Name="SortList"
                        MinHeight="100" SelectionMode="Single" SelectionChanged="OnSortSelectionChanged">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="Field" Width="180">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{Binding FieldOptions}"
                                    SelectedItem="{Binding FieldText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectionChanged="OnSortRowChanged" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Direction" Width="120">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{Binding DirectionOptions}"
                                    SelectedItem="{Binding DirectionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectionChanged="OnSortRowChanged" />
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                  </GridView>
                </ListView.View>
              </ListView>

              <!-- Placeholder row for layout grow -->
              <TextBlock Grid.Row="9" Grid.Column="0" Text="" />
            </Grid>
          </ScrollViewer>
        </Grid>
      </GroupBox>
    </Grid>

    <!-- Footer -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <TextBlock x:Name="StatusLbl" Foreground="DimGray" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button x:Name="SaveBtn" Content="Save" Width="80" Padding="4" Margin="0,0,8,0" Click="OnSave" IsEnabled="False" />
      <Button x:Name="SaveAsBtn" Content="Save As…" Width="90" Padding="4" Margin="0,0,8,0" Click="OnSaveAs" />
      <Button Content="Close" Width="80" Padding="4" Click="OnClose" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
