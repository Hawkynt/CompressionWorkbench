  <!-- Firmware / embedded boot images. Adjacent to the disk-image domain — they
       carry filesystem-shaped payloads (UEFI FFS, U-Boot uImage body) or
       describe board-level boot setup (Device Tree Blob, Intel HEX / Motorola
       S-Record / TI-TXT firmware dumps). -->
  <ItemGroup>
    <ProjectReference Include="..\FileFormats\FileFormat.Dtb\FileFormat.Dtb.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.FirmwareHex\FileFormat.FirmwareHex.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="_AddBundledAssembliesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_BundledRefs Include="@(ReferencePath)"
                    Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'
                               and '%(ReferencePath.Extension)' == '.dll'
                               and !$([System.String]::Copy('%(ReferencePath.MSBuildSourceProjectFile)').EndsWith('Hawkynt.Compression.Core.csproj'))
                               and !$([System.String]::Copy('%(ReferencePath.MSBuildSourceProjectFile)').EndsWith('Compression.Registry.csproj'))" />
      <TfmSpecificPackageFile Include="@(_BundledRefs)" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

  <!-- Keep the NuGet bundle exhaustive too. The Remove eliminates the
       legacy explicit subset above; the glob makes new FileSystem.* projects
       part of the package automatically. -->
  <ItemGroup>
    <ProjectReference Remove="..\FileSystems\FileSystem.*\FileSystem.*.csproj" />
    <ProjectReference Include="..\FileSystems\FileSystem.*\FileSystem.*.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
