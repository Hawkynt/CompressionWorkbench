<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <!-- Mirror FileFormat.PngCrushAdapters: tests that reference the sibling
         PngCrushCS repo (FileFormat.Png/Jpeg/Apng/Core/etc.) only compile when
         the sibling is checked out at ..\..\PNGCrushCS. CI without the sibling
         drops these tests instead of failing the build. -->
    <SiblingPresent>false</SiblingPresent>
    <!-- Sibling reorganized leaf FileFormat.* projects into a FileFormats/
         subdir but kept Compression.Core/FileFormat.Core at root. Probe both
         layouts. -->
    <PngCrushFormatsDir Condition="Exists('$(MSBuildThisFileDirectory)..\..\PNGCrushCS\FileFormats\FileFormat.Bmp\FileFormat.Bmp.csproj')">..\..\PNGCrushCS\FileFormats\</PngCrushFormatsDir>
    <PngCrushFormatsDir Condition="'$(PngCrushFormatsDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\PNGCrushCS\FileFormat.Bmp\FileFormat.Bmp.csproj')">..\..\PNGCrushCS\</PngCrushFormatsDir>
    <!-- Require every adapter sub-project the tests import. Mirror the gate in
         FileFormat.PngCrushAdapters.csproj so a half-checked-out sibling (Core
         present, sub-projects missing) is treated as "no sibling" instead of
         producing CS0234 errors. -->
    <SiblingPresent Condition="
      '$(PngCrushFormatsDir)' != '' and
      Exists('$(MSBuildThisFileDirectory)..\..\PNGCrushCS\FileFormat.Core\FileFormat.Core.csproj') and
      Exists('$(MSBuildThisFileDirectory)$(PngCrushFormatsDir)FileFormat.Png\FileFormat.Png.csproj') and
      Exists('$(MSBuildThisFileDirectory)$(PngCrushFormatsDir)FileFormat.Bmp\FileFormat.Bmp.csproj') and
      Exists('$(MSBuildThisFileDirectory)$(PngCrushFormatsDir)FileFormat.Apng\FileFormat.Apng.csproj') and
      Exists('$(MSBuildThisFileDirectory)$(PngCrushFormatsDir)FileFormat.Tiff\FileFormat.Tiff.csproj') and
      Exists('$(MSBuildThisFileDirectory)$(PngCrushFormatsDir)FileFormat.BigTiff\FileFormat.BigTiff.csproj') and
      Exists('$(MSBuildThisFileDirectory)$(PngCrushFormatsDir)FileFormat.Mng\FileFormat.Mng.csproj') and
      Exists('$(MSBuildThisFileDirectory)$(PngCrushFormatsDir)FileFormat.Fli\FileFormat.Fli.csproj') and
      Exists('$(MSBuildThisFileDirectory)$(PngCrushFormatsDir)FileFormat.Dcx\FileFormat.Dcx.csproj') and
      Exists('$(MSBuildThisFileDirectory)$(PngCrushFormatsDir)FileFormat.Icns\FileFormat.Icns.csproj') and
      Exists('$(MSBuildThisFileDirectory)$(PngCrushFormatsDir)FileFormat.Mpo\FileFormat.Mpo.csproj') and
      Exists('$(MSBuildThisFileDirectory)$(PngCrushFormatsDir)FileFormat.Jpeg\FileFormat.Jpeg.csproj')
      ">true</SiblingPresent>
  </PropertyGroup>

  <ItemGroup Condition="'$(SiblingPresent)' != 'true'">
    <!-- Tests that import sibling-only namespaces (FileFormat.Png, .Apng, .Jpeg,
         .Core, and the PngCrushAdapters surface that depends on them). -->
    <Compile Remove="Gif\GifColorSpaceTests.cs" />
    <Compile Remove="Gif\GifTests.cs" />
    <Compile Remove="Image\AllColorSpacesTests.cs" />
    <Compile Remove="Image\ColorSpaceLazinessTests.cs" />
    <Compile Remove="Image\ColorSpaceLazyExtractTests.cs" />
    <Compile Remove="Image\ColorSpaceSplitterTests.cs" />
    <Compile Remove="Png\PngLayoutMapTests.cs" />
    <Compile Remove="Png\PngPseudoArchiveTests.cs" />
    <Compile Remove="Tiff\TiffLayoutMapTests.cs" />
    <Compile Remove="Tiff\TiffPseudoArchiveTests.cs" />
    <Compile Remove="Mpo\MpoPseudoArchiveTests.cs" />
    <Compile Remove="Dcx\DcxPseudoArchiveTests.cs" />
    <Compile Remove="Icns\IcnsPseudoArchiveTests.cs" />
    <Compile Remove="PngCrushAdapters\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sibling FileFormat.Jpeg's transitive FrameworkExtensions.Backports
         exposes a duplicate Compression.Core.BitIO.BitOrder type. We pin
         FileFormat.Jpeg as PrivateAssets="all" inside FileFormat.PngCrushAdapters
         to keep the duplicate out of consumers' compile graphs (Compression.Lib /
         Compression.Tests / Compression.UI). Side effect: tests that imported
         `using FileFormat.Jpeg` directly can no longer compile, so we drop them
         unconditionally. The descriptor's behaviour is still exercised via the
         registry-iteration / SelfRoundTrip parameterized cases. -->
    <Compile Remove="PngCrushAdapters\JpegFormatDescriptorTests.cs" />
    <Compile Remove="PngCrushAdapters\JpegLazyMetadataTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="NUnit" Version="4.*" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hawkynt.FileFormats.Audio\Hawkynt.FileFormats.Audio.csproj" />
    <ProjectReference Include="..\Hawkynt.FileFormats.Archives\Hawkynt.FileFormats.Archives.csproj" />
    <ProjectReference Include="..\Compression.Core\Hawkynt.Compression.Core.csproj" />
    <ProjectReference Include="..\Compression.Lib\Compression.Lib.csproj" />
    <ProjectReference Include="..\Hawkynt.FileFormats.FileSystems\Hawkynt.FileFormats.FileSystems.csproj" />
    <!-- Compression.CLI builds a win-x64 single-file host (cwb.exe); its deps.json/
         runtimeconfig.json are publish-only artifacts, so a build-order ProjectReference
         tries to copy non-existent files (MSB3030) on a clean Release build. The CLI is
         built by the solution anyway, and ExecutablePackerCliTests locate cwb.exe at the
         win-x64 path and Assert.Ignore when absent, so no reference is needed here. -->
    <ProjectReference Include="..\Compression.Analysis\Compression.Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PngCrushCS sibling transitively requires System.IO.Hashing 10.0.3+
         (FileFormat.Jpeg → FrameworkExtensions.Backports). -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.3" />
  </ItemGroup>

</Project>
