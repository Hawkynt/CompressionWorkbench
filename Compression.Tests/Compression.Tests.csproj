<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ARC crawl fixtures; see IaArc/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="IaArc/ReferenceVectors/*.arc;IaArc/ReferenceVectors/*.arc.gz;IaArc/ReferenceVectors/warcio-listing.txt">
      <LogicalName>IaArcVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- mkfs.bfs volume filled by the Linux bfs driver; see Svr4Bfs/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Svr4Bfs/ReferenceVectors/*.gz;Svr4Bfs/ReferenceVectors/*.manifest">
      <LogicalName>Svr4BfsVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- The image tests build FileFormat.Core.RawImage / FileFormat.Png values and
         hand them to the FileFormat.PngCrushAdapters surface in Compression.Lib, which
         keeps the package's compile assets private. Referenced under the `images` alias
         because the package also carries a Compression.Core.BitIO.BitOrder and a
         FileFormat.Wad.WadWriter whose names collide with Hawkynt.Compression.Core and
         Hawkynt.FileFormats.Archives; only the files that need the image types opt in
         with `extern alias images`. -->
    <PackageReference Include="Hawkynt.FileFormats.Images" Version="1.0.0.145" Aliases="images" />
    <!-- Pulled in transitively by the package above. Its extension polyfills (e.g.
         Reverse on arrays) are ambiguous against .NET 10's own System.Linq, so it
         stays out of the global alias too. -->
    <PackageReference Include="FrameworkExtensions.Backports" Version="1.0.0.256" Aliases="images" />
    <PackageReference Include="coverlet.collector" Version="6.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="NUnit" Version="4.*" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hawkynt.FileFormats.Audio\Hawkynt.FileFormats.Audio.csproj" />
    <ProjectReference Include="..\Hawkynt.FileFormats.Archives\Hawkynt.FileFormats.Archives.csproj" />
    <ProjectReference Include="..\Compression.Core\Hawkynt.Compression.Core.csproj" />
    <ProjectReference Include="..\Compression.Lib\Compression.Lib.csproj" />
    <ProjectReference Include="..\Hawkynt.FileFormats.FileSystems\Hawkynt.FileFormats.FileSystems.csproj" />
    <!-- Compression.CLI builds a win-x64 single-file host (cwb.exe); its deps.json/
         runtimeconfig.json are publish-only artifacts, so a build-order ProjectReference
         tries to copy non-existent files (MSB3030) on a clean Release build. The CLI is
         built by the solution anyway, and ExecutablePackerCliTests locate cwb.exe at the
         win-x64 path and Assert.Ignore when absent, so no reference is needed here. -->
    <ProjectReference Include="..\Compression.Analysis\Compression.Analysis.csproj" />
    <!-- The NativeUI tests build the shell against a headless backend and paint its own-drawn
         controls into a buffer. It is a WinExe, but nothing here is published, so it is an ordinary
         build-order reference. -->
    <ProjectReference Include="..\Compression.NativeUI\Compression.NativeUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The universal SFX stub's format resolution, compiled from the stub's own source so the tests
         exercise exactly what ships. The carved branch and the stub's registration host are not
         linked: the test project already has the full registry through Compression.Lib. -->
    <Compile Include="..\Compression.Sfx.Shared\SfxFormatResolver.cs" Link="Sfx\Shared\SfxFormatResolver.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hawkynt.FileFormats.Images requires System.IO.Hashing 10.0.3+. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bytes written by the reference implementation of each structured format: CPython pickle,
         python-msgpack, Windows reg.exe, Perl Storable, .NET BinaryFormatter, and two real registry
         hives. They are embedded rather than copied so the gate cannot silently pass on a runner
         where a content file failed to deploy, and checked in rather than downloaded so it cannot
         pass on a runner with no network. See ReferenceVectors/README.md for provenance; the
         generator scripts beside them are documentation, not build inputs. -->
    <EmbeddedResource Include="StructuredPseudoArchives\ReferenceVectors\*"
                      Exclude="StructuredPseudoArchives\ReferenceVectors\*.py;StructuredPseudoArchives\ReferenceVectors\*.pl;StructuredPseudoArchives\ReferenceVectors\*.ps1;StructuredPseudoArchives\ReferenceVectors\README.md">
      <LogicalName>ReferenceVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Volumes a Reiser4 kernel wrote under mkfs.reiser4 plugin profiles, with the kernel's read-back;
         see Reiser4/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Reiser4\ReferenceVectors\*.gz;Reiser4\ReferenceVectors\*.manifest">
      <LogicalName>Reiser4Vectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- The QEMU harness that lets a Reiser4 kernel judge what the writer produces. -->
    <None Include="Reiser4\KernelOracle\*.sh" CopyToOutputDirectory="PreserveNewest" LinkBase="Reiser4\KernelOracle" />
    <!-- Volumes the Linux btrfs driver wrote with compress-force; see Btrfs/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Btrfs\ReferenceVectors\*.gz;Btrfs\ReferenceVectors\manifest.txt">
      <LogicalName>BtrfsVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Volumes bcachefs-tools wrote; see BcacheFs/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="BcacheFs\ReferenceVectors\*.gz;BcacheFs\ReferenceVectors\manifest*.txt">
      <LogicalName>BcacheFsVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- A package built by Windows iexpress.exe, plus expand.exe's extraction; see IExpress/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="IExpress\ReferenceVectors\*.gz;IExpress\ReferenceVectors\oracle.tsv">
      <LogicalName>IExpressVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Installers compiled by makensis 2.51 / 3.10, plus 7-Zip's extraction; see Nsis/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Nsis\ReferenceVectors\*.gz;Nsis\ReferenceVectors\oracle.tsv">
      <LogicalName>NsisVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Disks qemu-img / qemu-io wrote; see Vmdk/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Vmdk\ReferenceVectors\*.gz;Vmdk\ReferenceVectors\manifest.txt">
      <LogicalName>VmdkVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- A MOBI book written by calibre; see Mobi/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Mobi\ReferenceVectors\*.mobi">
      <LogicalName>MobiVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- keramics' VHDX test disks; see Vhdx/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Vhdx\ReferenceVectors\*.gz;Vhdx\ReferenceVectors\manifest.txt">
      <LogicalName>VhdxVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Streams written by libcsc's reference csc tool; see Csc/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Csc\ReferenceVectors\*.csc">
      <LogicalName>CscVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Firmware images written by each format's reference tool; see Firmware/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Firmware\ReferenceVectors\*" Exclude="Firmware\ReferenceVectors\README.md">
      <LogicalName>FirmwareVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Archives FreeArc 0.67's Arc.exe wrote; see FreeArc/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="FreeArc\ReferenceVectors\*.arc">
      <LogicalName>FreeArcVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Archives the reference zpaq 7.15 wrote, with a manifest of their contents; see Zpaq/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Zpaq\ReferenceVectors\*.zpaq;Zpaq\ReferenceVectors\manifest.tsv">
      <LogicalName>ZpaqVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- CVF cluster payloads the dmsdos compressors wrote; see Cvf/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Cvf\ReferenceVectors\*.bin">
      <LogicalName>CvfVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- AFF4 logical images from pyaff4 (its reference image dream.aff4 and two it wrote) plus pyaff4's
         own read-back listing; see Aff4/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Aff4\ReferenceVectors\*.aff4;Aff4\ReferenceVectors\*.tsv">
      <LogicalName>Aff4Vectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- OneNote sections from the Apache Tika test corpus; see OneNote/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="OneNote\ReferenceVectors\*.one">
      <LogicalName>OneNoteVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Sparsebundles written by Apple's hdiutil (keramics, ewfprobe test corpora); see
         AppleSparse/ReferenceVectors/README.md. The tests rebuild each bundle directory from these. -->
    <EmbeddedResource Include="AppleSparse\ReferenceVectors\**\*"
                      Exclude="AppleSparse\ReferenceVectors\README.md;AppleSparse\ReferenceVectors\.gitattributes">
      <LogicalName>SparsebundleVectors/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- FLA files and an XFL project saved by Flash Professional CS6, from the JPEXS FFDec test data,
         with xfl2svg's captured reports; see Fla/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Fla\ReferenceVectors\**\*" Exclude="Fla\ReferenceVectors\README.md;Fla\ReferenceVectors\.gitattributes">
      <LogicalName>FlaVectors.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Macrium's MIT-licensed Reflect X metadata schema, the oracle for the writer's $JSON block.
         Provenance in Macrium/VendorSchema/THIRD-PARTY-NOTICE.MacriumSchema.txt. -->
    <EmbeddedResource Include="Macrium\VendorSchema\required_schema.json" LogicalName="MacriumVendor.required_schema.json" />
    <!-- keramics' HFS+ volume written on macOS (decmpfs files); see HfsPlus/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="HfsPlus\ReferenceVectors\*.gz">
      <LogicalName>HfsPlusVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Rock Ridge images xorriso wrote; see Iso/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Iso\ReferenceVectors\*.gz;Iso\ReferenceVectors\manifest-*.txt">
      <LogicalName>IsoVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- LZBITMAP pairs from libzbitmap's test corpus; see Lzbitmap/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Lzbitmap\ReferenceVectors\*-*" Exclude="Lzbitmap\ReferenceVectors\README.md">
      <LogicalName>LzbitmapVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Pools OpenZFS 2.2.2 created, with the mounted pools' SHA-256 manifests; see Zfs/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Zfs\ReferenceVectors\*.gz;Zfs\ReferenceVectors\*.manifest">
      <LogicalName>ZfsVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- 7z archives 7-Zip 26.03, 7-Zip-zstd 26.02 and py7zr wrote; see SevenZip/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="SevenZip\ReferenceVectors\*.7z;SevenZip\ReferenceVectors\manifest.txt">
      <LogicalName>SevenZipVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- ACE archives from acefile's test corpus and ones our writer produced for acefile; see Ace/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Ace\ReferenceVectors\*.ace;Ace\ReferenceVectors\acefile-listing.txt">
      <LogicalName>AceVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- G.722 streams FFmpeg 8.1.2 encoded and decoded; see Codecs/G722/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Codecs\G722\ReferenceVectors\*.pcm;Codecs\G722\ReferenceVectors\*.g722">
      <LogicalName>G722Vectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Fossil volume written by plan9port's fossil server; see Fossil/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Fossil\ReferenceVectors\*.gz;Fossil\ReferenceVectors\*.manifest">
      <LogicalName>FossilVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Zoo archives written by Zoo 2.10; see Zoo/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Zoo\ReferenceVectors\*.zoo">
      <LogicalName>ZooVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- MARs from mardor's test data and written by mardor; see Mar/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Mar\ReferenceVectors\*.mar;Mar\ReferenceVectors\mardor-listing.txt">
      <LogicalName>MarVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- VDF volumes from GothicVDFS, VDFSTool and ZenKit, with ZenKit's listings; see Vdfs/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Vdfs\ReferenceVectors\*.vdf;Vdfs\ReferenceVectors\*.tsv">
      <LogicalName>VdfsVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- ZIP archives written by third-party archivers; see Zip/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Zip\ReferenceVectors\*.zip">
      <LogicalName>ZipVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- BagIt bags bagit-python made, and ours it validated; see BagIt/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="BagIt\ReferenceVectors\*.zip">
      <LogicalName>BagItVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- DAR slices written by dar itself (2.4.24 to 2.8.6); see Dar/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Dar\ReferenceVectors\*.dar">
      <LogicalName>DarVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Archives the open-source ARJ port wrote with each method; see Arj/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Arj\ReferenceVectors\*.arj">
      <LogicalName>ArjVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Real IT modules with compressed samples plus libxmp's PCM digests; see Codecs/TrackerXmIt/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Codecs\TrackerXmIt\ReferenceVectors\*.it;Codecs\TrackerXmIt\ReferenceVectors\*.sha256.txt">
      <LogicalName>ItVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- XAR archives libarchive's bsdtar wrote with each encoding; see Xar/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Xar\ReferenceVectors\*.xar">
      <LogicalName>XarVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- -lh2- / -lh3- archives UNLHA32.DLL wrote, from lhasa's test suite; see Lzh/ReferenceVectors/README.md. -->
    <!-- Archives other LHA-family tools wrote, from lhasa's test suite; see Lzh/ReferenceVectors/README.md. -->
    <EmbeddedResource Include="Lzh\ReferenceVectors\*.lzh;Lzh\ReferenceVectors\*.lzs;Lzh\ReferenceVectors\*.pma">
      <LogicalName>LzhVectors.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
