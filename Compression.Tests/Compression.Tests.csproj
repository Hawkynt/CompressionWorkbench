<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The image tests build FileFormat.Core.RawImage / FileFormat.Png values and
         hand them to the FileFormat.PngCrushAdapters surface in Compression.Lib, which
         keeps the package's compile assets private. Referenced under the `images` alias
         because the package also carries a Compression.Core.BitIO.BitOrder and a
         FileFormat.Wad.WadWriter whose names collide with Hawkynt.Compression.Core and
         Hawkynt.FileFormats.Archives; only the files that need the image types opt in
         with `extern alias images`. -->
    <PackageReference Include="Hawkynt.FileFormats.Images" Version="1.0.0.145" Aliases="images" />
    <!-- Pulled in transitively by the package above. Its extension polyfills (e.g.
         Reverse on arrays) are ambiguous against .NET 10's own System.Linq, so it
         stays out of the global alias too. -->
    <PackageReference Include="FrameworkExtensions.Backports" Version="1.0.0.256" Aliases="images" />
    <PackageReference Include="coverlet.collector" Version="6.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="NUnit" Version="4.*" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hawkynt.FileFormats.Audio\Hawkynt.FileFormats.Audio.csproj" />
    <ProjectReference Include="..\Hawkynt.FileFormats.Archives\Hawkynt.FileFormats.Archives.csproj" />
    <ProjectReference Include="..\Compression.Core\Hawkynt.Compression.Core.csproj" />
    <ProjectReference Include="..\Compression.Lib\Compression.Lib.csproj" />
    <ProjectReference Include="..\Hawkynt.FileFormats.FileSystems\Hawkynt.FileFormats.FileSystems.csproj" />
    <!-- Compression.CLI builds a win-x64 single-file host (cwb.exe); its deps.json/
         runtimeconfig.json are publish-only artifacts, so a build-order ProjectReference
         tries to copy non-existent files (MSB3030) on a clean Release build. The CLI is
         built by the solution anyway, and ExecutablePackerCliTests locate cwb.exe at the
         win-x64 path and Assert.Ignore when absent, so no reference is needed here. -->
    <ProjectReference Include="..\Compression.Analysis\Compression.Analysis.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Pcm\Codec.Pcm.csproj" />
    <ProjectReference Include="..\Codecs\Codec.ALaw\Codec.ALaw.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Gsm610\Codec.Gsm610.csproj" />
    <ProjectReference Include="..\Codecs\Codec.ImaAdpcm\Codec.ImaAdpcm.csproj" />
    <ProjectReference Include="..\Codecs\Codec.MsAdpcm\Codec.MsAdpcm.csproj" />
    <ProjectReference Include="..\Codecs\Codec.MuLaw\Codec.MuLaw.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Mp3\Codec.Mp3.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Vorbis\Codec.Vorbis.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Opus\Codec.Opus.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Aac\Codec.Aac.csproj" />
    <ProjectReference Include="..\Codecs\Codec.OkiAdpcm\Codec.OkiAdpcm.csproj" />
    <ProjectReference Include="..\Codecs\Codec.G72x\Codec.G72x.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Alac\Codec.Alac.csproj" />
    <ProjectReference Include="..\Codecs\Codec.G722\Codec.G722.csproj" />
    <ProjectReference Include="..\Codecs\Codec.AicaAdpcm\Codec.AicaAdpcm.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Ra144\Codec.Ra144.csproj" />
    <ProjectReference Include="..\Codecs\Codec.TrueSpeech\Codec.TrueSpeech.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Wma\Codec.Wma.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Ac3\Codec.Ac3.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Cook\Codec.Cook.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Atrac3\Codec.Atrac3.csproj" />
    <ProjectReference Include="..\Codecs\Codec.WmaPro\Codec.WmaPro.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Sipr\Codec.Sipr.csproj" />
    <ProjectReference Include="..\Codecs\Codec.AdpcmX\Codec.AdpcmX.csproj" />
    <ProjectReference Include="..\Codecs\Codec.BinkAudio\Codec.BinkAudio.csproj" />
    <ProjectReference Include="..\Codecs\Codec.SmackerAudio\Codec.SmackerAudio.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Ra288\Codec.Ra288.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Ralf\Codec.Ralf.csproj" />
    <ProjectReference Include="..\Codecs\Codec.WmaLossless\Codec.WmaLossless.csproj" />
    <ProjectReference Include="..\Codecs\Codec.Dfpwm\Codec.Dfpwm.csproj" />
    <ProjectReference Include="..\FileFormats\FileFormat.Akb\FileFormat.Akb.csproj" />
    <ProjectReference Include="..\FileFormats\FileFormat.Avi\FileFormat.Avi.csproj" />
    <ProjectReference Include="..\FileFormats\FileFormat.Awb\FileFormat.Awb.csproj" />
    <ProjectReference Include="..\FileFormats\FileFormat.Matroska\FileFormat.Matroska.csproj" />
    <ProjectReference Include="..\FileFormats\FileFormat.Mp4\FileFormat.Mp4.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hawkynt.FileFormats.Images requires System.IO.Hashing 10.0.3+. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.3" />
    <ProjectReference Include="..\FileFormats\FileFormat.Psf\FileFormat.Psf.csproj" />
    <ProjectReference Include="..\FileFormats\FileFormat.Wav\FileFormat.Wav.csproj" />
    <ProjectReference Include="..\FileFormats\FileFormat.Asf\FileFormat.Asf.csproj" />
    <ProjectReference Include="..\FileFormats\FileFormat.RealMedia\FileFormat.RealMedia.csproj" />
    <ProjectReference Include="..\FileFormats\FileFormat.Bik\FileFormat.Bik.csproj" />
    <ProjectReference Include="..\FileFormats\FileFormat.Smk\FileFormat.Smk.csproj" />
  </ItemGroup>

</Project>
