<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Compression.NativeUI</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <!-- NativeForms from a source checkout when there is one, else from nuget.org. -->
  <Import Project="..\build\NativeForms.props" />

  <ItemGroup>
    <!--
      The preview window decodes through this package, which carries readers for several hundred
      image formats. It is aliased because it also ships FileFormat.Dng.DngReader and
      FileFormat.Heif.HeifReader under the same fully-qualified names as Compression.Lib's own,
      and an unaliased reference would make both ambiguous.
    -->
    <PackageReference Include="Hawkynt.FileFormats.Images" Version="1.0.0.145" Aliases="images" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compression.Lib\Compression.Lib.csproj" />
    <ProjectReference Include="..\Compression.Analysis\Compression.Analysis.csproj" />
    <ProjectReference Include="..\Compression.Mounting\Compression.Mounting.csproj" />
    <ProjectReference Include="..\Compression.Mounting.Dokan\Compression.Mounting.Dokan.csproj" />
    <ProjectReference Include="..\Compression.Mounting.Fuse\Compression.Mounting.Fuse.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shell and its controls are internal; the tests drive them directly. -->
    <InternalsVisibleTo Include="Compression.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The About window renders this at runtime, so the shipped binary always describes its own build. -->
    <EmbeddedResource Include="..\README.md" Link="README.md" LogicalName="README.md" />
  </ItemGroup>

</Project>
