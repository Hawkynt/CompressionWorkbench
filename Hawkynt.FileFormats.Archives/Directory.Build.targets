    <ProjectReference Include="..\FileFormats\FileFormat.NetCdf\FileFormat.NetCdf.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Orc\FileFormat.Orc.csproj" PrivateAssets="all" />
