<Project>
  <!--
    Archive-domain formats that another meta-package also claims, so they cannot be compiled into
    this assembly without duplicating their types. They stay separate projects and are bundled as
    DLLs instead: _AddBundledAssembliesToPackage copies their output into this package, and the
    references stay private so they do not become NuGet dependencies.
  -->
  <ItemGroup>
    <!-- Game / runtime audio bundles and A/V envelopes — also in Hawkynt.FileFormats.Audio. -->
    <ProjectReference Include="..\FileFormats\FileFormat.Akb\FileFormat.Akb.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Asf\FileFormat.Asf.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Awb\FileFormat.Awb.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Bik\FileFormat.Bik.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Psf\FileFormat.Psf.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.RealMedia\FileFormat.RealMedia.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Smk\FileFormat.Smk.csproj" PrivateAssets="all" />

    <!-- Console filesystem/tape images — also in Hawkynt.FileFormats.FileSystems. -->
    <ProjectReference Include="..\FileFormats\FileFormat.Pfs0\FileFormat.Pfs0.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.T64\FileFormat.T64.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
