    <ProjectReference Include="..\FileFormats\FileFormat.Arrow\FileFormat.Arrow.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Avro\FileFormat.Avro.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Fits\FileFormat.Fits.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Iceberg\FileFormat.Iceberg.csproj" PrivateAssets="all" />
