    <ProjectReference Include="..\FileFormats\FileFormat.Xps\FileFormat.Xps.csproj" PrivateAssets="all" />

    <!-- Executable images and console ROMs surfaced as pseudo-archives. -->
    <ProjectReference Include="..\FileFormats\FileFormat.Elf\FileFormat.Elf.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.Gb\FileFormat.Gb.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormats\FileFormat.MachO\FileFormat.MachO.csproj" PrivateAssets="all" />
