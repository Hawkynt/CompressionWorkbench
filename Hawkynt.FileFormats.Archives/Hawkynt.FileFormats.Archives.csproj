<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Compiles the archive-domain format sources directly (FileFormats/FileFormat.*), and bundles
         the DLLs of the format projects it still references into one NuGet drop. Folder + .csproj
         filename equal $(MSBuildProjectName) so $(PackageId) defaults correctly under the .NET 10
         SDK (see Compression.Core/Hawkynt.Compression.Core.csproj for the rationale).

         The compiled-in sources declare their own namespaces (FileFormat.Rar, Compression.Formats.*,
         …), so $(RootNamespace) applies to nothing they contain. -->
    <RootNamespace>Hawkynt.FileFormats.Archives</RootNamespace>
    <!-- Folded in from the absorbed projects that carried it; the archive long tail documents its
         public surface in REFERENCE.md rather than per-member XML comments. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <Title>Hawkynt FileFormats Archives</Title>
    <Description>Pure-managed compression streams (gzip / bzip2 / xz / zstd / brotli / lz4 / snappy / lzma / lzop / lrzip / and the long tail) and archive containers (zip / tar / 7z / rar / cab / wim / cpio / ar / xar / and the rest) plus software-package containers (apk / ipa / nupkg / deb / rpm / appx / msix / wheel / crate), Office Open XML / OpenDocument zip-bundles, comic-book archives, and the long tail of game / install-suite / Amiga / vintage formats. Self-contained bundle on top of Hawkynt.Compression.Core.</Description>
    <PackageTags>$(PackageTags);archive;zip;tar;7z;rar;cab;wim;gzip;bzip2;xz;zstd;brotli;lz4;snappy;lzma;deb;rpm;apk;ipa;managed</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddBundledAssembliesToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Collapsed from the absorbed format projects, which each granted it separately. -->
    <InternalsVisibleTo Include="Compression.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compression.Core\Hawkynt.Compression.Core.csproj" />
    <!-- The descriptors compiled in here implement Compression.Registry's contracts. The registry
         used to arrive transitively, through the format projects this package bundled; with those
         gone the reference has to be named. It stays private so it is neither a nuspec dependency
         nor a second copy of an assembly Compression.Core's package already ships. -->
    <ProjectReference Include="..\Compression.Registry\Compression.Registry.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- The media containers are bundled through one reference to Hawkynt.FileFormats.Audio, declared
       in this package's Directory.Build.targets. -->

  <!-- SUPPORT-MATRIX-FORMATS:BEGIN — namespaces of formats this package delivers without compiling
       them: the archive-domain ones that compile into Compression.Core (the stream codecs, ZIP, and
       the console container images), reached through the Core dependency — the SquashFs payload
       reader AppImage and Snap need among them — and the media containers, which compile into
       Hawkynt.FileFormats.Audio and arrive in the bundled copy of its assembly. Either way the
       descriptor reports another assembly's name, so the row is claimed by namespace instead; read
       by Compression.Tests/Operations/ArchivesReadmeStateTests.cs,
       Compression.Tests/Operations/CreatableFormatsRoundTripTests.cs and
       Compression.Tests/Packaging/ArchivePackageCompletenessTests.cs. Inert to MSBuild. -->
  <ItemGroup>
    <SupportMatrixNamespace Include="FileFormat.Bzip2" />
    <SupportMatrixNamespace Include="FileFormat.Lzfse" />
    <SupportMatrixNamespace Include="FileFormat.Lzma" />
    <SupportMatrixNamespace Include="FileFormat.Xz" />
    <SupportMatrixNamespace Include="FileFormat.Zip" />
    <SupportMatrixNamespace Include="FileFormat.Zlib" />
    <SupportMatrixNamespace Include="FileFormat.Zstd" />
    <SupportMatrixNamespace Include="FileFormat.Pfs0" />
    <SupportMatrixNamespace Include="FileFormat.T64" />
    <SupportMatrixNamespace Include="FileFormat.Lynx" />
    <SupportMatrixNamespace Include="FileFormat.Akb" />
    <SupportMatrixNamespace Include="FileFormat.Asf" />
    <SupportMatrixNamespace Include="FileFormat.Avi" />
    <SupportMatrixNamespace Include="FileFormat.Awb" />
    <SupportMatrixNamespace Include="FileFormat.Bik" />
    <SupportMatrixNamespace Include="FileFormat.Matroska" />
    <SupportMatrixNamespace Include="FileFormat.Mp4" />
    <SupportMatrixNamespace Include="FileFormat.Psf" />
    <SupportMatrixNamespace Include="FileFormat.RealMedia" />
    <SupportMatrixNamespace Include="FileFormat.Smk" />
  </ItemGroup>
  <!-- SUPPORT-MATRIX-FORMATS:END -->

  <Target Name="_AddBundledAssembliesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_BundledRefs Include="@(ReferencePath)"
                    Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'
                               and '%(ReferencePath.Extension)' == '.dll'
                               and !$([System.String]::Copy('%(ReferencePath.MSBuildSourceProjectFile)').EndsWith('Hawkynt.Compression.Core.csproj'))
                               and !$([System.String]::Copy('%(ReferencePath.MSBuildSourceProjectFile)').EndsWith('Compression.Registry.csproj'))" />
      <TfmSpecificPackageFile Include="@(_BundledRefs)" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

</Project>
