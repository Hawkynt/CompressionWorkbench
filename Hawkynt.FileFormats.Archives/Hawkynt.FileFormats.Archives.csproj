<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Meta-package. Has no source code of its own; bundles every compression-
         stream + archive-container DLL into one NuGet drop. Folder + .csproj
         filename equal $(MSBuildProjectName) so $(PackageId) defaults correctly
         under the .NET 10 SDK (see Compression.Core/Hawkynt.Compression.Core.csproj
         for the rationale). -->
    <RootNamespace>Hawkynt.FileFormats.Archives</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS2008</NoWarn>

    <IsPackable>true</IsPackable>
    <Title>Hawkynt FileFormats Archives</Title>
    <Description>Pure-managed compression streams (gzip / bzip2 / xz / zstd / brotli / lz4 / snappy / lzma / lzop / lrzip / and the long tail) and archive containers (zip / tar / 7z / rar / cab / wim / cpio / ar / xar / and the rest) plus software-package containers (apk / ipa / nupkg / deb / rpm / appx / msix / wheel / crate), Office Open XML / OpenDocument zip-bundles, comic-book archives, and the long tail of game / install-suite / Amiga / vintage formats. Self-contained bundle on top of Hawkynt.Compression.Core.</Description>
    <PackageTags>$(PackageTags);archive;zip;tar;7z;rar;cab;wim;gzip;bzip2;xz;zstd;brotli;lz4;snappy;lzma;deb;rpm;apk;ipa;managed</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddBundledAssembliesToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compression.Core\Hawkynt.Compression.Core.csproj" />
  </ItemGroup>

