<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Compression.Sfx.Cli</RootNamespace>
    <AssemblyName>sfx-cli</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    NativeAOT, so a self-extracting archive needs nothing installed on the machine it lands on.
    That was the point: the old stub was framework-dependent, so handing someone an SFX without
    .NET on their box simply failed.

    Costura and PublishSingleFile are deliberately gone. Costura works by embedding assemblies as
    resources and resolving them through Assembly.Load(byte[]), which AOT cannot do at all.
  -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!--
      Trim analysis across the whole format library is noisy and not actionable from here; the
      guarantee that matters is behavioural and comes from the round-trip gate, which extracts a
      real archive with the published stub and compares bytes.
    -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <NoWarn>$(NoWarn);IL2026;IL2070;IL2072;IL2075;IL2077;IL2087;IL2091;IL3050;IL3053</NoWarn>
  </PropertyGroup>

  <!-- Carved: one format, named directly, so the linker drops every other. ~1.5 MB. -->
  <PropertyGroup Condition="'$(SfxTier)' == 'Carved'">
    <DefineConstants>$(DefineConstants);SFX_TIER_CARVED;SFX_FORMAT_$(SfxFormat.ToUpperInvariant())</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(SfxTier)' == 'Carved'">
    <ProjectReference Include="..\Compression.Registry\Compression.Registry.csproj" />
    <ProjectReference Include="..\Compression.Core\Hawkynt.Compression.Core.csproj" />
    <ProjectReference Include="..\Hawkynt.FileFormats.Archives\Hawkynt.FileFormats.Archives.csproj" />
  </ItemGroup>

  <!--
    Universal: every archive descriptor, discovered by the generator from this project's reference
    closure. Compression.Lib is deliberately absent — routing through it would add the filesystem
    and audio descriptors, which no SFX payload can ever be, and triples the binary (33 MB vs 10 MB).
  -->
  <ItemGroup Condition="'$(SfxTier)' != 'Carved'">
    <ProjectReference Include="..\Compression.Registry\Compression.Registry.csproj" />
    <ProjectReference Include="..\Compression.Core\Hawkynt.Compression.Core.csproj" />
    <ProjectReference Include="..\Hawkynt.FileFormats.Archives\Hawkynt.FileFormats.Archives.csproj" />
    <ProjectReference Include="..\Compression.Registry.Generator\Compression.Registry.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Compression.Sfx.Shared\SfxPayload.cs" Link="Shared\SfxPayload.cs" />
    <Compile Include="..\Compression.Sfx.Shared\SfxFormatResolver.cs" Link="Shared\SfxFormatResolver.cs" />
    <Compile Include="..\Compression.Sfx.Shared\GeneratedRegistrationHost.cs" Link="Shared\GeneratedRegistrationHost.cs"
             Condition="'$(SfxTier)' != 'Carved'" />
  </ItemGroup>

</Project>
