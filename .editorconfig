# Baseline editorconfig — see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets}]
indent_size = 4

# Imported codec sources are source dependencies, not style-exempt black boxes.
# Keep their original license/provenance notices, but compile and maintain them
# with the same language/runtime settings as the repository and apply safe
# modern C# syntax whenever Roslyn can perform the rewrite mechanically.
[Codecs/Codec.*/Vendored/**/*.cs]
# These files are upstream copies at a pinned revision, kept byte-for-byte so a
# later revision can be dropped in. The repository compiles warnings as errors
# with nullable reference types on; upstream was written without either, and
# rewriting 1800 sites would fork the copies from what they claim to be. The
# diagnostics are silenced for these paths only — never for our own code.
dotnet_diagnostic.CS8600.severity = none
dotnet_diagnostic.CS8601.severity = none
dotnet_diagnostic.CS8602.severity = none
dotnet_diagnostic.CS8603.severity = none
dotnet_diagnostic.CS8604.severity = none
dotnet_diagnostic.CS8618.severity = none
dotnet_diagnostic.CS8619.severity = none
dotnet_diagnostic.CS8625.severity = none
dotnet_diagnostic.CS8629.severity = none
dotnet_diagnostic.CS8765.severity = none
dotnet_diagnostic.CS8767.severity = none
dotnet_diagnostic.CS8981.severity = none
dotnet_diagnostic.CS0169.severity = none
dotnet_diagnostic.CS0642.severity = none
dotnet_diagnostic.CS0649.severity = none
dotnet_diagnostic.CS0652.severity = none
dotnet_diagnostic.CS0675.severity = none
dotnet_diagnostic.CA2022.severity = none
dotnet_diagnostic.CA2265.severity = none

[Codecs/Codec.*/Vendored/**/*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

[*.{md,markdown}]
trim_trailing_whitespace = false   # trailing spaces are hard line-breaks

[*.{sln,slnx}]
indent_style = tab

[Makefile]
indent_style = tab
