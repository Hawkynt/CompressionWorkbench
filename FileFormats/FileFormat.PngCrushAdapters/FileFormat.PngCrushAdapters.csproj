<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FileFormat.PngCrushAdapters</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Compression.Registry\Compression.Registry.csproj" />
    <ProjectReference Include="..\FileFormat.Gif\FileFormat.Gif.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Image parsing/encoding belongs to PNGCrushCS. Keep its compile assets private to this
      bridge assembly because the package also carries support assemblies with namespaces that
      overlap CompressionWorkbench internals. Runtime assets still flow to applications that
      consume the bridge; public bridge APIs expose only CompressionWorkbench contracts.
    -->
    <PackageReference Include="Hawkynt.FileFormats.Images" Version="1.0.0.131" PrivateAssets="compile" />
  </ItemGroup>

</Project>
